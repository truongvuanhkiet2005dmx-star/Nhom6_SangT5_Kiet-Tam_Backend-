{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=smartmoney-family.db"
  },
  "Jwt": {
    "Issuer": "SmartMoney.Api",
    "Audience": "SmartMoney.Flutter",
    "Key": "<SET_A_LONG_RANDOM_JWT_KEY>"
  },
  "Firebase": {
    "ProjectId": "smartmoney-quanlychitieu",
    "ServiceAccountPath": "<PATH_TO_SERVICE_ACCOUNT_JSON>"
  },
  "Smtp": {
    "Host": "<SMTP_HOST>",
    "Port": 587,
    "Username": "<SMTP_USERNAME>",
    "Password": "<SMTP_PASSWORD>",
    "FromEmail": "<FROM_EMAIL>",
    "FromName": "SmartMoney",
    "EnableSsl": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  }
}
